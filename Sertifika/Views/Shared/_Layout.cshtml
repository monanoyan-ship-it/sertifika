<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Sertifika Sistemi")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    @if (ViewData["ActiveMenu"] != null)
    {
        var activeMenu = ViewData["ActiveMenu"]!.ToString();
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Panel" asp-action="Dashboard">
                    <i class="bi bi-award me-2"></i>Sertifika Sistemi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(activeMenu == "dashboard" ? "active" : "")" asp-controller="Panel" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(activeMenu == "templates" ? "active" : "")" asp-controller="Panel" asp-action="Templates">Sablonlar</a></li>
                        <li class="nav-item"><a class="nav-link @(activeMenu == "signatures" ? "active" : "")" asp-controller="Panel" asp-action="Signatures">Imzalar</a></li>
                        <li class="nav-item"><a class="nav-link @(activeMenu == "trainings" ? "active" : "")" asp-controller="Panel" asp-action="Trainings">Egitimler</a></li>
                        <li class="nav-item"><a class="nav-link @(activeMenu == "companies" ? "active" : "")" asp-controller="Panel" asp-action="Companies">Firmalar</a></li>
                        <li class="nav-item"><a class="nav-link @(activeMenu == "settings" ? "active" : "")" asp-controller="Panel" asp-action="Settings">Ayarlar</a></li>
                    </ul>
                    <div class="navbar-nav">
                        <span class="nav-link text-light" id="nav-username"><i class="bi bi-person-circle me-1"></i></span>
                        <a class="nav-link" href="#" onclick="logout(); return false;"><i class="bi bi-box-arrow-right me-1"></i>Cikis</a>
                    </div>
                </div>
            </div>
        </nav>
    }

    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/build/toastr.min.js"></script>
    <script src="~/js/common.js"></script>
    <script>
        // Show username in navbar
        (function() {
            var user = JSON.parse(localStorage.getItem('user') || 'null');
            var el = document.getElementById('nav-username');
            if (el && user) {
                el.innerHTML = '<i class="bi bi-person-circle me-1"></i>' + user.firstName + ' ' + user.lastName;
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
