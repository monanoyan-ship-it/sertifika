<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Sertifika Sistemi - Egitim sertifikalarinin hazirlanmasi, yonetimi ve dogrulanmasi icin yonetim paneli.">
    <meta name="theme-color" content="#0d6efd">
    <title>@(ViewData["Title"] ?? "Sertifika Sistemi")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>
    @if (ViewData["ActiveMenu"] != null)
    {
        var activeMenu = ViewData["ActiveMenu"]!.ToString();
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark" aria-label="Ana navigasyon">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Panel" asp-action="Dashboard">
                        <i class="bi bi-award me-2" aria-hidden="true"></i>Sertifika Sistemi
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar" aria-expanded="false" aria-label="Menuyu ac/kapat">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @(activeMenu == "dashboard" ? "active" : "")" asp-controller="Panel" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(activeMenu == "templates" ? "active" : "")" asp-controller="Panel" asp-action="Templates">Sablonlar</a></li>
                            <li class="nav-item"><a class="nav-link @(activeMenu == "signatures" ? "active" : "")" asp-controller="Panel" asp-action="Signatures">Imzalar</a></li>
                            <li class="nav-item"><a class="nav-link @(activeMenu == "trainings" ? "active" : "")" asp-controller="Panel" asp-action="Trainings">Egitimler</a></li>
                            <li class="nav-item"><a class="nav-link @(activeMenu == "companies" ? "active" : "")" asp-controller="Panel" asp-action="Companies">Firmalar</a></li>
                            <li class="nav-item"><a class="nav-link @(activeMenu == "emailtemplates" ? "active" : "")" asp-controller="Panel" asp-action="EmailTemplates">E-posta Sablonlari</a></li>
                            <li class="nav-item"><a class="nav-link @(activeMenu == "settings" ? "active" : "")" asp-controller="Panel" asp-action="Settings">Ayarlar</a></li>
                        </ul>
                        <div class="navbar-nav">
                            <span class="nav-link text-light" id="nav-username"><i class="bi bi-person-circle me-1" aria-hidden="true"></i></span>
                            <a class="nav-link" href="#" onclick="logout(); return false;"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cikis</a>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="bg-light border-top py-3 mt-4 text-center text-muted small">
        <div class="container">
            &copy; @DateTime.Now.Year Sertifika Sistemi &middot; v1.0
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/common.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
