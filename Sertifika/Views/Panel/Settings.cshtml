@{
    ViewData["Title"] = "Ayarlar";
}

<div class="container mt-4" id="settingsApp">
    <h2 class="mb-4">Ayarlar</h2>

    <!-- OneDrive Accounts -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>OneDrive Hesaplari</h4>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle me-1"></i> Yeni Hesap
        </button>
    </div>

    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <div class="row g-3" data-bind="foreach: accounts, visible: !isLoading()">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title" data-bind="text: name"></h5>
                        <!-- ko if: isDefault -->
                        <span class="badge bg-success">Varsayilan</span>
                        <!-- /ko -->
                    </div>
                    <p class="mb-1 small"><strong>Tenant:</strong> <code data-bind="text: tenantId"></code></p>
                    <p class="mb-1 small"><strong>Client:</strong> <code data-bind="text: clientId"></code></p>
                    <p class="mb-0 small"><strong>Drive User:</strong> <code data-bind="text: driveUserId"></code></p>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
                    <!-- ko ifnot: isDefault -->
                    <button class="btn btn-sm btn-outline-success" data-bind="click: $parent.setDefault">
                        <i class="bi bi-check-circle me-1"></i>Varsayilan Yap
                    </button>
                    <!-- /ko -->
                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteAccount">
                        <i class="bi bi-trash me-1"></i>Sil
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div data-bind="visible: !isLoading() && accounts().length === 0" class="text-center py-5 text-muted">
        <i class="bi bi-cloud display-1"></i>
        <p class="mt-2">Henuz OneDrive hesabi yok.</p>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni OneDrive Hesabi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form data-bind="submit: saveAccount">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Hesap Adi</label>
                        <input type="text" class="form-control" data-bind="value: formData().name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tenant ID</label>
                        <input type="text" class="form-control" data-bind="value: formData().tenantId" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Client ID</label>
                        <input type="text" class="form-control" data-bind="value: formData().clientId" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Client Secret</label>
                        <input type="password" class="form-control" data-bind="value: formData().clientSecret" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Drive User ID</label>
                        <input type="text" class="form-control" data-bind="value: formData().driveUserId" required>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="od-default" data-bind="checked: formData().isDefault">
                        <label class="form-check-label" for="od-default">Varsayilan hesap</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="submit" class="btn btn-primary" data-bind="disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Settings.js"></script>
}
