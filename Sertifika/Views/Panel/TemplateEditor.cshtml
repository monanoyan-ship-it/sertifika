@{
    ViewData["Title"] = ViewData["TemplateId"] != null ? "Sablon Duzenle" : "Yeni Sablon";
    var templateId = ViewData["TemplateId"];
}

<div class="container-fluid mt-3" id="editorApp">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0" data-bind="text: editorTitle"></h4>
        <div class="btn-toolbar gap-2">
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-secondary" data-bind="click: addStaticField" title="Sabit Metin">
                    <i class="bi bi-fonts me-1"></i>Metin
                </button>
                <button class="btn btn-sm btn-outline-primary" data-bind="click: addDynamicField" title="Dinamik Alan">
                    <i class="bi bi-braces me-1"></i>Dinamik
                </button>
                <button class="btn btn-sm btn-outline-success" data-bind="click: addQrCodeField" title="QR Kod">
                    <i class="bi bi-qr-code me-1"></i>QR
                </button>
                <div class="btn-group">
                    <button class="btn btn-sm btn-outline-warning dropdown-toggle" data-bs-toggle="dropdown"
                            data-bind="disable: addableSignatures().length === 0">
                        <i class="bi bi-pen me-1"></i>Imza
                    </button>
                    <ul class="dropdown-menu">
                        <!-- ko foreach: addableSignatures -->
                        <li>
                            <a class="dropdown-item" href="#" data-bind="click: $parent.addSignature">
                                <i class="bi bi-pen me-1"></i><span data-bind="text: name + ' (' + title + ')'"></span>
                            </a>
                        </li>
                        <!-- /ko -->
                        <!-- ko if: addableSignatures().length === 0 -->
                        <li><span class="dropdown-item text-muted">Tum imzalar eklenmis</span></li>
                        <!-- /ko -->
                    </ul>
                </div>
            </div>
            <div class="btn-group">
                <button class="btn btn-sm" data-bind="click: function(){ showGuides(!showGuides()); }, css: { 'btn-info': showGuides(), 'btn-outline-info': !showGuides() }" title="Kilavuz Cizgileri">
                    <i class="bi bi-grid-3x3"></i>
                </button>
                <button class="btn btn-sm" data-bind="click: function(){ useSampleData(!useSampleData()); }, css: { 'btn-success': useSampleData(), 'btn-outline-success': !useSampleData() }" title="Ornek Veri ile Goster">
                    <i class="bi bi-magic"></i>
                </button>
            </div>
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-info" data-bind="click: previewTemplate, disable: isPreviewing">
                    <span data-bind="visible: isPreviewing" class="spinner-border spinner-border-sm me-1"></span>
                    <i class="bi bi-eye me-1" data-bind="visible: !isPreviewing()"></i>PDF Onizleme
                </button>
                <button class="btn btn-primary btn-sm" data-bind="click: saveTemplate, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <i class="bi bi-floppy me-1" data-bind="visible: !isSaving()"></i>Kaydet
                </button>
                <a asp-action="Templates" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Canvas -->
        <div class="col-lg-9">
            <div class="border rounded bg-white position-relative overflow-hidden" id="editor-canvas"
                 data-bind="css: { 'editor-landscape': orientation() === '0', 'editor-portrait': orientation() === '1', 'show-guides': showGuides() }, click: function(d,e) { if (e.target.id === 'editor-canvas' || e.target.id === 'editor-bg') clearSelection(); }">
                <img id="editor-bg" class="position-absolute w-100 h-100" style="object-fit: cover; top:0; left:0;"
                     data-bind="attr: { src: backgroundPreview }, visible: backgroundPreview()" loading="lazy" alt="Sertifika arka plani">
                <!-- Guide Lines (toggle) -->
                <div class="guide-layer" data-bind="visible: showGuides()">
                    <div class="guide-margin"></div>
                    <div class="guide-center-v"></div>
                    <div class="guide-center-h"></div>
                </div>
                <!-- Snap lines (dynamic - drawn by JS during drag) -->
                <div class="snap-v" id="snap-v" style="display:none;"></div>
                <div class="snap-h" id="snap-h" style="display:none;"></div>
            </div>
            <div class="mt-2 d-flex flex-wrap gap-3 small text-muted">
                <span><i class="bi bi-square-fill" style="color:#3498db"></i> Alan</span>
                <span data-bind="visible: templateSignatures().length > 0"><i class="bi bi-square-fill" style="color:#e67e22"></i> Imza</span>
                <span data-bind="visible: templateSignatures().length > 0"><i class="bi bi-square-fill" style="color:#27ae60"></i> Ad</span>
                <span data-bind="visible: templateSignatures().length > 0"><i class="bi bi-square-fill" style="color:#8e44ad"></i> Unvan</span>
                <span class="ms-auto text-muted">Ipuclari: Ctrl+D cogalt, Ctrl+C/V kopyala-yapistir, Del sil, oklarla 0.5% kaydir</span>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-3">
            <!-- Template Settings -->
            <div class="card shadow-sm mb-2">
                <div class="card-header py-2"><strong><i class="bi bi-gear me-1"></i>Sablon Ayarlari</strong></div>
                <div class="card-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Ad</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: templateName">
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Aciklama</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: templateDesc">
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <label class="form-label small fw-semibold">Yonelim</label>
                            <select class="form-select form-select-sm" data-bind="value: orientation">
                                <option value="0">Yatay</option>
                                <option value="1">Dikey</option>
                            </select>
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold">&nbsp;</label>
                            <input type="file" class="form-control form-control-sm" id="tpl-bg-file" accept="image/*" title="Arka plan">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Fields Panel -->
            <div class="card shadow-sm mb-2">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-braces me-1"></i>Dinamik Alanlar</strong>
                    <small class="text-muted">tikla-ekle</small>
                </div>
                <div class="card-body p-2">
                    <div class="d-grid gap-1">
                        <!-- ko foreach: dynamicKeys -->
                        <button type="button" class="btn btn-sm btn-outline-primary text-start py-1 px-2"
                                data-bind="click: function(){ $parent.addDynamicFieldWithKey(key); }"
                                style="font-size: 0.75rem;">
                            <span class="badge bg-primary me-1" data-bind="text: '{' + key + '}'"></span>
                            <span data-bind="text: label"></span>
                        </button>
                        <!-- /ko -->
                    </div>
                </div>
            </div>

            <!-- Selected Field Properties -->
            <div class="card shadow-sm mb-2" data-bind="visible: selectedField()">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-sliders me-1"></i>Alan Ozellikleri</strong>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-secondary" data-bind="click: duplicateSelectedField" title="Cogalt (Ctrl+D)">
                            <i class="bi bi-stickies"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" data-bind="click: deleteSelectedField" title="Sil (Del)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-3" data-bind="with: selectedField">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Tip</label>
                        <div>
                            <span class="badge" data-bind="text: $parent.getFieldTypeLabel(fieldType),
                                css: { 'bg-secondary': fieldType === 'static', 'bg-primary': fieldType === 'dynamic', 'bg-success': fieldType === 'qrcode' }"></span>
                        </div>
                    </div>

                    <!-- ko if: fieldType === 'static' -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Metin</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: staticText, event: { input: $parent.onFieldChanged }">
                    </div>
                    <!-- /ko -->

                    <!-- ko if: fieldType === 'dynamic' -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Dinamik Alan</label>
                        <select class="form-select form-select-sm" data-bind="value: dynamicKey, options: $parent.dynamicKeysText, optionsText: 'label', optionsValue: 'key', event: { change: $parent.onFieldChanged }"></select>
                    </div>
                    <!-- /ko -->

                    <!-- Position X/Y/W/H -->
                    <div class="border rounded p-2 mb-2 bg-light">
                        <div class="small text-muted mb-1 fw-semibold"><i class="bi bi-arrows-move me-1"></i>Konum & Boyut (%)</div>
                        <div class="row g-1">
                            <div class="col-6">
                                <label class="form-label small mb-0">X</label>
                                <input type="number" class="form-control form-control-sm" step="0.1" min="0" max="100"
                                       data-bind="value: x, event: { change: $parent.onFieldChanged }">
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0">Y</label>
                                <input type="number" class="form-control form-control-sm" step="0.1" min="0" max="100"
                                       data-bind="value: y, event: { change: $parent.onFieldChanged }">
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0">Genislik</label>
                                <input type="number" class="form-control form-control-sm" step="0.1" min="1" max="100"
                                       data-bind="value: width, event: { change: $parent.onFieldChanged }">
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0">Yukseklik</label>
                                <input type="number" class="form-control form-control-sm" step="0.1" min="1" max="100"
                                       data-bind="value: height, event: { change: $parent.onFieldChanged }">
                            </div>
                        </div>
                    </div>

                    <!-- Layer -->
                    <div class="border rounded p-2 mb-2 bg-light">
                        <div class="small text-muted mb-1 fw-semibold"><i class="bi bi-layers me-1"></i>Katman</div>
                        <div class="btn-group btn-group-sm w-100">
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.bringToFront" title="En One">
                                <i class="bi bi-chevron-double-up"></i>
                            </button>
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.bringForward" title="One">
                                <i class="bi bi-chevron-up"></i>
                            </button>
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.sendBackward" title="Arkaya">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.sendToBack" title="En Arkaya">
                                <i class="bi bi-chevron-double-down"></i>
                            </button>
                        </div>
                    </div>

                    <!-- ko if: fieldType !== 'qrcode' -->
                    <!-- Typography -->
                    <div class="border rounded p-2 bg-light">
                        <div class="small text-muted mb-1 fw-semibold"><i class="bi bi-type me-1"></i>Tipografi</div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Font</label>
                            <select class="form-select form-select-sm" data-bind="value: fontFamily, options: $parent.availableFonts, event: { change: $parent.onFieldChanged }"></select>
                        </div>
                        <div class="row g-1 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-0">Boyut</label>
                                <input type="number" class="form-control form-control-sm" min="6" max="96" step="0.5" data-bind="value: fontSize, event: { change: $parent.onFieldChanged }">
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0">Renk</label>
                                <input type="color" class="form-control form-control-sm form-control-color w-100" data-bind="value: fontColor, event: { change: $parent.onFieldChanged }">
                            </div>
                        </div>
                        <div class="row g-1 mb-2">
                            <div class="col-6">
                                <label class="form-label small mb-0" title="Harf Arasi">Harf Arasi</label>
                                <input type="number" class="form-control form-control-sm" step="0.1" data-bind="value: letterSpacing, event: { change: $parent.onFieldChanged }">
                            </div>
                            <div class="col-6">
                                <label class="form-label small mb-0" title="Satir Yuk.">Satir Yuk.</label>
                                <input type="number" class="form-control form-control-sm" step="0.1" min="0.8" max="3" data-bind="value: lineHeight, event: { change: $parent.onFieldChanged }">
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm w-100 mb-2">
                            <input type="radio" class="btn-check" name="align" id="align-l" value="left" data-bind="checked: textAlign, event: { change: $parent.onFieldChanged }">
                            <label class="btn btn-outline-secondary" for="align-l"><i class="bi bi-text-left"></i></label>
                            <input type="radio" class="btn-check" name="align" id="align-c" value="center" data-bind="checked: textAlign, event: { change: $parent.onFieldChanged }">
                            <label class="btn btn-outline-secondary" for="align-c"><i class="bi bi-text-center"></i></label>
                            <input type="radio" class="btn-check" name="align" id="align-r" value="right" data-bind="checked: textAlign, event: { change: $parent.onFieldChanged }">
                            <label class="btn btn-outline-secondary" for="align-r"><i class="bi bi-text-right"></i></label>
                        </div>
                        <div class="btn-group btn-group-sm w-100">
                            <input type="checkbox" class="btn-check" id="fmt-bold" data-bind="checked: isBold, event: { change: $parent.onFieldChanged }">
                            <label class="btn btn-outline-secondary" for="fmt-bold"><i class="bi bi-type-bold"></i></label>
                            <input type="checkbox" class="btn-check" id="fmt-italic" data-bind="checked: isItalic, event: { change: $parent.onFieldChanged }">
                            <label class="btn btn-outline-secondary" for="fmt-italic"><i class="bi bi-type-italic"></i></label>
                            <input type="checkbox" class="btn-check" id="fmt-underline" data-bind="checked: isUnderline, event: { change: $parent.onFieldChanged }">
                            <label class="btn btn-outline-secondary" for="fmt-underline"><i class="bi bi-type-underline"></i></label>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>

            <!-- Selected Signature Properties (kept compact) -->
            <div class="card shadow-sm mb-2" data-bind="visible: selectedSig()">
                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-pen me-1"></i>Imza</strong>
                    <div>
                        <span class="badge me-1" data-bind="text: selectedSigPart() === 'sig-image' ? 'Gorsel' : (selectedSigPart() === 'sig-name' ? 'Ad' : 'Unvan'),
                            style: { backgroundColor: selectedSigPart() === 'sig-image' ? '#e67e22' : (selectedSigPart() === 'sig-name' ? '#27ae60' : '#8e44ad') }"></span>
                        <button class="btn btn-sm btn-outline-danger" data-bind="click: removeSelectedSignature">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-3" data-bind="with: selectedSig">
                    <div class="mb-2">
                        <span class="text-muted small" data-bind="text: signature.name + ' — ' + signature.title"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Egitimci Adi</label>
                        <input type="text" class="form-control form-control-sm" data-bind="textInput: instructorName">
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Egitimci Unvani</label>
                        <input type="text" class="form-control form-control-sm" data-bind="textInput: instructorTitle">
                    </div>
                    <div class="d-flex gap-3 mb-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: showName">
                            <label class="form-check-label small">Ad</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: showTitle">
                            <label class="form-check-label small">Unvan</label>
                        </div>
                    </div>
                    <div class="row g-1 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-0">Ad Boyutu</label>
                            <input type="number" class="form-control form-control-sm" min="4" max="48" data-bind="value: nameFontSize">
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-0">Unvan Boyutu</label>
                            <input type="number" class="form-control form-control-sm" min="4" max="48" data-bind="value: titleFontSize">
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary w-100" data-bind="click: $parent.rotateSelectedSignature">
                        <i class="bi bi-arrow-clockwise me-1"></i>Dondur (<span data-bind="text: (imageRotation() * 90) + '°'"></span>)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-earmark-pdf me-2"></i>PDF Onizleme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="previewFrame" style="width:100%; height:75vh; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>var templateId = @(templateId != null ? templateId : "null");</script>
    <script src="~/js/TemplateEditor.js" asp-append-version="true"></script>
}
