@{
    ViewData["Title"] = ViewData["TemplateId"] != null ? "Sablon Duzenle" : "Yeni Sablon";
    var templateId = ViewData["TemplateId"];
}

<div class="container-fluid mt-3" id="editorApp">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 data-bind="text: editorTitle"></h2>
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary" data-bind="click: addStaticField">
                <i class="bi bi-fonts me-1"></i>Metin Ekle
            </button>
            <button class="btn btn-sm btn-outline-primary" data-bind="click: addDynamicField">
                <i class="bi bi-braces me-1"></i>Dinamik Alan
            </button>
            <button class="btn btn-sm btn-outline-success" data-bind="click: addQrCodeField">
                <i class="bi bi-qr-code me-1"></i>QR Kod
            </button>
            <!-- Imza Ekle dropdown -->
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-warning dropdown-toggle" data-bs-toggle="dropdown"
                        data-bind="disable: addableSignatures().length === 0">
                    <i class="bi bi-pen me-1"></i>Imza Ekle
                </button>
                <ul class="dropdown-menu">
                    <!-- ko foreach: addableSignatures -->
                    <li>
                        <a class="dropdown-item" href="#" data-bind="click: $parent.addSignature">
                            <i class="bi bi-pen me-1"></i><span data-bind="text: name + ' (' + title + ')'"></span>
                        </a>
                    </li>
                    <!-- /ko -->
                    <!-- ko if: addableSignatures().length === 0 -->
                    <li><span class="dropdown-item text-muted">Tum imzalar eklenmis</span></li>
                    <!-- /ko -->
                </ul>
            </div>
            <button class="btn btn-sm btn-outline-info" data-bind="click: previewTemplate, disable: isPreviewing">
                <span data-bind="visible: isPreviewing" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-eye me-1" data-bind="visible: !isPreviewing()"></i>On Izleme
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: saveTemplate, disable: isSaving">
                <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-floppy me-1" data-bind="visible: !isSaving()"></i>Kaydet
            </button>
            <a asp-action="Templates" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Geri
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Canvas -->
        <div class="col-md-9">
            <div class="border rounded bg-white position-relative overflow-hidden" id="editor-canvas"
                 data-bind="css: { 'editor-landscape': orientation() === '0', 'editor-portrait': orientation() === '1' }, click: function(d,e) { if (e.target.id === 'editor-canvas' || e.target.id === 'editor-bg') clearSelection(); }">
                <img id="editor-bg" class="position-absolute w-100 h-100" style="object-fit: cover; top:0; left:0;"
                     data-bind="attr: { src: backgroundPreview }, visible: backgroundPreview()" loading="lazy" alt="Sertifika arka plani">
            </div>
            <!-- Legend -->
            <div class="mt-2 d-flex gap-3 small text-muted" data-bind="visible: templateSignatures().length > 0">
                <span><i class="bi bi-square-fill" style="color:#e67e22"></i> Imza Gorseli</span>
                <span><i class="bi bi-square-fill" style="color:#27ae60"></i> Egitimci Adi</span>
                <span><i class="bi bi-square-fill" style="color:#8e44ad"></i> Egitimci Unvani</span>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Sablon Ayarlari</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Sablon Adi</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: templateName">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Aciklama</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: templateDesc">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Yonelim</label>
                        <select class="form-select form-select-sm" data-bind="value: orientation">
                            <option value="0">Yatay (Landscape)</option>
                            <option value="1">Dikey (Portrait)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Arka Plan</label>
                        <input type="file" class="form-control form-control-sm" id="tpl-bg-file" accept="image/*">
                    </div>
                </div>
            </div>

            <!-- Selected Layout Field Properties -->
            <div class="card shadow-sm mt-3" data-bind="visible: selectedField()">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Secili Alan</strong>
                    <button class="btn btn-sm btn-outline-danger" data-bind="click: deleteSelectedField">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="card-body" data-bind="with: selectedField">
                    <div class="mb-2">
                        <label class="form-label">Tip</label>
                        <span class="badge" data-bind="text: $parent.getFieldTypeLabel(fieldType),
                            css: { 'bg-secondary': fieldType === 'static', 'bg-primary': fieldType === 'dynamic', 'bg-success': fieldType === 'qrcode' }"></span>
                    </div>
                    <!-- ko if: fieldType === 'static' -->
                    <div class="mb-2">
                        <label class="form-label">Metin</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: staticText, event: { input: $parent.onFieldChanged }">
                    </div>
                    <!-- /ko -->
                    <!-- ko if: fieldType === 'dynamic' -->
                    <div class="mb-2">
                        <label class="form-label">Dinamik Alan</label>
                        <select class="form-select form-select-sm" data-bind="value: dynamicKey, event: { change: $parent.onFieldChanged }">
                            <option value="HolderName">Katilimci Ad Soyad</option>
                            <option value="TrainingName">Egitim Adi</option>
                            <option value="TrainingDate">Egitim Tarihi</option>
                            <option value="CompanyName">Firma Adi</option>
                            <option value="CertificateNo">Sertifika No</option>
                        </select>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: fieldType !== 'qrcode' -->
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Font</label>
                            <select class="form-select form-select-sm" data-bind="value: fontFamily, event: { change: $parent.onFieldChanged }">
                                <option value="Arial">Arial</option>
                                <option value="Times">Times</option>
                                <option value="Courier">Courier</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Boyut</label>
                            <input type="number" class="form-control form-control-sm" min="8" max="72" data-bind="value: fontSize, event: { change: $parent.onFieldChanged }">
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Renk</label>
                            <input type="color" class="form-control form-control-sm" data-bind="value: fontColor, event: { change: $parent.onFieldChanged }">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Hizalama</label>
                            <select class="form-select form-select-sm" data-bind="value: textAlign, event: { change: $parent.onFieldChanged }">
                                <option value="left">Sol</option>
                                <option value="center">Orta</option>
                                <option value="right">Sag</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: isBold, event: { change: $parent.onFieldChanged }">
                            <label class="form-check-label">Kalin</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: isItalic, event: { change: $parent.onFieldChanged }">
                            <label class="form-check-label">Italik</label>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>

            <!-- Selected Signature Properties -->
            <div class="card shadow-sm mt-3" data-bind="visible: selectedSig()">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Imza Ayarlari</strong>
                    <div>
                        <span class="badge me-1" data-bind="text: selectedSigPart() === 'sig-image' ? 'Gorsel' : (selectedSigPart() === 'sig-name' ? 'Ad' : 'Unvan'),
                            style: { backgroundColor: selectedSigPart() === 'sig-image' ? '#e67e22' : (selectedSigPart() === 'sig-name' ? '#27ae60' : '#8e44ad') }"></span>
                        <button class="btn btn-sm btn-outline-danger" data-bind="click: removeSelectedSignature" title="Imzayi kaldir">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body" data-bind="with: selectedSig">
                    <div class="mb-2">
                        <span class="text-muted small" data-bind="text: signature.name + ' — ' + signature.title"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Egitimci Adi</label>
                        <input type="text" class="form-control form-control-sm" data-bind="textInput: instructorName">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Egitimci Unvani</label>
                        <input type="text" class="form-control form-control-sm" data-bind="textInput: instructorTitle">
                    </div>
                    <div class="d-flex gap-3 mb-2">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: showName">
                            <label class="form-check-label">Ad Goster</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: showTitle">
                            <label class="form-check-label">Unvan Goster</label>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label">Ad Boyutu</label>
                            <input type="number" class="form-control form-control-sm" min="4" max="48" data-bind="value: nameFontSize">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Unvan Boyutu</label>
                            <input type="number" class="form-control form-control-sm" min="4" max="48" data-bind="value: titleFontSize">
                        </div>
                    </div>
                    <div class="mb-2">
                        <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.rotateSelectedSignature">
                            <i class="bi bi-arrow-clockwise me-1"></i>Gorseli Dondir
                        </button>
                        <span class="text-muted small ms-1" data-bind="text: (imageRotation() * 90) + '°'"></span>
                    </div>
                    <!-- ko if: signature.imageUrl -->
                    <div class="text-center mt-2">
                        <img data-bind="attr: { src: signature.imageUrl }" class="img-fluid border rounded" style="max-height: 50px;" loading="lazy" alt="Imza onizlemesi">
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">On Izleme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="previewFrame" style="width:100%; height:75vh; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>var templateId = @(templateId != null ? templateId : "null");</script>
    <script src="~/js/TemplateEditor.js" asp-append-version="true"></script>
}
