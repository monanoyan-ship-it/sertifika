@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giris - Sertifika Sistemi</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm mt-5" id="loginApp">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <i class="bi bi-award display-3 text-primary"></i>
                            <h3 class="mt-2">Sertifika Sistemi</h3>
                            <p class="text-muted">Yonetim Paneli</p>
                        </div>
                        <form data-bind="submit: login">
                            <div class="mb-3">
                                <label class="form-label">E-posta</label>
                                <input type="email" class="form-control" data-bind="value: email" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Sifre</label>
                                <input type="password" class="form-control" data-bind="value: password" required>
                            </div>
                            <div class="alert alert-danger" data-bind="visible: errorMessage, text: errorMessage"></div>
                            <button type="submit" class="btn btn-primary w-100" data-bind="disable: isLoading">
                                <span data-bind="visible: isLoading" class="spinner-border spinner-border-sm me-1"></span>
                                Giris Yap
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/common.js"></script>
    <script src="~/js/Login.js"></script>
</body>
</html>
