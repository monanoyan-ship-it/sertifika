@{
    Layout = "_Layout";
    var code = ViewData["StatusCode"] as int? ?? 500;
    var title = code switch
    {
        404 => "Sayfa bulunamadi",
        403 => "Erisim reddedildi",
        401 => "Yetkisiz erisim",
        _ => "Bir hata olustu"
    };
    var desc = code switch
    {
        404 => "Aradiginiz sayfa mevcut degil veya tasinmis olabilir.",
        403 => "Bu sayfayi goruntulemek icin yetkiniz yok.",
        401 => "Lutfen giris yapin.",
        _ => "Beklenmeyen bir hata olustu. Lutfen tekrar deneyin."
    };
    ViewData["Title"] = title;
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="text-center">
        <div class="display-1 text-muted fw-bold">@code</div>
        <h2 class="mb-3">@title</h2>
        <p class="text-muted mb-4">@desc</p>
        <a asp-controller="Panel" asp-action="Dashboard" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Ana sayfaya don
        </a>
    </div>
</div>
