@{
    ViewData["Title"] = "Firma Yonetimi";
}

<div class="container mt-4" id="companiesApp">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Firma Yonetimi</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success" data-bind="click: openImportModal">
                <i class="bi bi-file-earmark-arrow-up me-1"></i>Toplu Yukle (CSV)
            </button>
            <button class="btn btn-primary" data-bind="click: openCreateModal">
                <i class="bi bi-plus-circle me-1"></i> Yeni Firma
            </button>
        </div>
    </div>

    <div class="mb-3" data-bind="visible: !isLoading() && companies().length > 0">
        <input type="text" class="form-control" placeholder="Firma ara (ad, e-posta, telefon)..." data-bind="textInput: searchQuery">
    </div>

    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <div class="table-responsive" data-bind="visible: !isLoading() && filteredCompanies().length > 0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Firma Adi</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>Adres</th>
                    <th style="width: 100px;" class="text-end">Islem</th>
                </tr>
            </thead>
            <tbody data-bind="foreach: filteredCompanies">
                <tr>
                    <td>
                        <a data-bind="attr: { href: '/Panel/CompanyDetail/' + id }, text: name" class="text-decoration-none"></a>
                    </td>
                    <td class="text-muted" data-bind="text: contactEmail"></td>
                    <td class="text-muted" data-bind="text: contactPhone"></td>
                    <td class="text-muted small" data-bind="text: address"></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-info me-1" data-bind="attr: { href: '/Panel/CompanyDetail/' + id }" title="Detay">
                            <i class="bi bi-eye"></i>
                        </a>
                        <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.openEditModal" title="Duzenle">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteCompany" title="Sil">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div data-bind="visible: !isLoading() && companies().length === 0" class="text-center py-5 text-muted">
        <i class="bi bi-building display-1"></i>
        <p class="mt-2">Henuz firma yok.</p>
    </div>

    <div data-bind="visible: !isLoading() && companies().length > 0 && filteredCompanies().length === 0" class="text-center py-3 text-muted">
        <p>Aramayla eslesen firma bulunamadi.</p>
    </div>

    <!-- Create/Edit Modal (CRM) -->
    <div class="modal fade" id="formModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-building me-2"></i><span data-bind="text: isEditing() ? 'Firma Duzenle' : 'Yeni Firma'"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form data-bind="submit: saveCompany">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Firma Adi <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                                    <input type="text" class="form-control" data-bind="textInput: formName" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">E-posta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input type="email" class="form-control" data-bind="textInput: formContactEmail">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Telefon</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input type="text" class="form-control" data-bind="textInput: formContactPhone">
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Adres</label>
                                <textarea class="form-control" rows="2" data-bind="textInput: formAddress" placeholder="Fatura / sevkiyat adresi"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Iptal</button>
                        <button type="submit" class="btn btn-primary" data-bind="disable: isSaving">
                            <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                            <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>
                            <span data-bind="text: isEditing() ? 'Guncelle' : 'Kaydet'"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Toplu Yukle Modal -->
    <div class="modal fade" id="importModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-arrow-up me-2"></i>Toplu Firma / Katilimci Yukle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small py-2">
                        <i class="bi bi-info-circle me-1"></i>
                        CSV'deki her satir bir kisi-firma-egitim iliskisidir. Firma/egitim yoksa otomatik olusturulur.
                        <a href="#" data-bind="click: downloadImportTemplate" class="fw-semibold">
                            <i class="bi bi-download me-1"></i>Sablon indir
                        </a>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">CSV Dosyasi</label>
                        <input type="file" id="import-csv-file" class="form-control" accept=".csv,.txt">
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Varsayilan Sertifika Sablonu
                            <i class="bi bi-info-circle text-muted" title="CSV'de yeni egitim olusursa bu sablon atanir"></i>
                        </label>
                        <select class="form-select" data-bind="options: availableTemplates, optionsText: 'name', optionsValue: 'id', value: importTemplateId, optionsCaption: 'Sablon secin...'"></select>
                    </div>

                    <button class="btn btn-outline-primary" data-bind="click: runPreview, disable: isImporting">
                        <span data-bind="visible: isImporting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-search me-1" data-bind="visible: !isImporting()"></i>Onizleme Goster
                    </button>

                    <!-- Preview result -->
                    <div class="mt-3" data-bind="visible: previewResult()">
                        <hr>
                        <h6 class="mb-3"><i class="bi bi-clipboard-data me-1"></i>Onizleme Sonuclari</h6>

                        <div class="row g-2 mb-3">
                            <div class="col-md-3"><div class="border rounded p-2 text-center"><div class="small text-muted">Yeni Firma</div><div class="h5 mb-0 text-success" data-bind="text: previewResult() ? previewResult().newCompanies.length : 0"></div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2 text-center"><div class="small text-muted">Yeni Egitim</div><div class="h5 mb-0 text-success" data-bind="text: previewResult() ? previewResult().newTrainings.length : 0"></div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2 text-center"><div class="small text-muted">Yeni Kisi</div><div class="h5 mb-0 text-success" data-bind="text: previewResult() ? previewResult().newContacts.length : 0"></div></div></div>
                            <div class="col-md-3"><div class="border rounded p-2 text-center"><div class="small text-muted">Zaten Var</div><div class="h5 mb-0 text-muted" data-bind="text: previewResult() ? previewResult().existingParticipations : 0"></div></div></div>
                        </div>

                        <div class="mb-2" data-bind="visible: previewResult() && previewResult().errors.length > 0">
                            <div class="alert alert-danger small py-2 mb-0">
                                <strong>Hatalar:</strong>
                                <ul class="mb-0 ps-3" data-bind="foreach: previewResult() ? previewResult().errors : []">
                                    <li data-bind="text: $data"></li>
                                </ul>
                            </div>
                        </div>

                        <div class="mb-2" data-bind="visible: previewResult() && previewResult().warnings.length > 0">
                            <div class="alert alert-warning small py-2 mb-0">
                                <strong>Uyarilar:</strong>
                                <ul class="mb-0 ps-3" data-bind="foreach: previewResult() ? previewResult().warnings : []">
                                    <li data-bind="text: $data"></li>
                                </ul>
                            </div>
                        </div>

                        <div class="accordion" id="previewAccordion">
                            <div class="accordion-item" data-bind="visible: previewResult() && previewResult().newCompanies.length > 0">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pvCompanies">Yeni Firmalar (<span data-bind="text: previewResult() ? previewResult().newCompanies.length : 0"></span>)</button></h2>
                                <div id="pvCompanies" class="accordion-collapse collapse" data-bs-parent="#previewAccordion">
                                    <div class="accordion-body small">
                                        <ul class="mb-0 ps-3" data-bind="foreach: previewResult() ? previewResult().newCompanies : []"><li data-bind="text: $data"></li></ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item" data-bind="visible: previewResult() && previewResult().newTrainings.length > 0">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pvTrainings">Yeni Egitimler (<span data-bind="text: previewResult() ? previewResult().newTrainings.length : 0"></span>)</button></h2>
                                <div id="pvTrainings" class="accordion-collapse collapse" data-bs-parent="#previewAccordion">
                                    <div class="accordion-body small">
                                        <table class="table table-sm mb-0"><thead><tr><th>Firma</th><th>Egitim</th><th>Tarih</th><th>Egitmen</th></tr></thead>
                                            <tbody data-bind="foreach: previewResult() ? previewResult().newTrainings : []">
                                                <tr><td data-bind="text: companyName"></td><td data-bind="text: name"></td><td data-bind="text: formatDateRange(trainingDate, endDate)"></td><td data-bind="text: instructorName || '-'"></td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item" data-bind="visible: previewResult() && previewResult().newContacts.length > 0">
                                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#pvContacts">Yeni Kisiler (<span data-bind="text: previewResult() ? previewResult().newContacts.length : 0"></span>)</button></h2>
                                <div id="pvContacts" class="accordion-collapse collapse" data-bs-parent="#previewAccordion">
                                    <div class="accordion-body small">
                                        <table class="table table-sm mb-0"><thead><tr><th>Firma</th><th>Ad Soyad</th><th>E-posta</th></tr></thead>
                                            <tbody data-bind="foreach: previewResult() ? previewResult().newContacts : []">
                                                <tr><td data-bind="text: companyName"></td><td data-bind="text: fullName"></td><td data-bind="text: email || '-'"></td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm result -->
                    <div class="mt-3" data-bind="visible: confirmResult()">
                        <hr>
                        <div class="alert alert-success small py-2 mb-2">
                            <strong>Import tamamlandi:</strong>
                            <ul class="mb-0 ps-3">
                                <li data-bind="text: 'Firma olusturuldu: ' + (confirmResult() ? confirmResult().companiesCreated : 0)"></li>
                                <li data-bind="text: 'Egitim olusturuldu: ' + (confirmResult() ? confirmResult().trainingsCreated : 0)"></li>
                                <li data-bind="text: 'Kisi olusturuldu: ' + (confirmResult() ? confirmResult().contactsCreated : 0)"></li>
                                <li data-bind="text: 'Katilim eklendi: ' + (confirmResult() ? confirmResult().participantsCreated : 0)"></li>
                                <li data-bind="text: 'Atlanan: ' + (confirmResult() ? confirmResult().rowsSkipped : 0)"></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button class="btn btn-success" data-bind="click: runConfirm, visible: previewResult() && !confirmResult(), disable: isImporting || !importTemplateId()">
                        <span data-bind="visible: isImporting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-circle me-1" data-bind="visible: !isImporting()"></i>Onayla ve Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Companies.js"></script>
}
