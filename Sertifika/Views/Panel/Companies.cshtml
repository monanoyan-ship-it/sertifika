@{
    ViewData["Title"] = "Firma Yonetimi";
}

<div class="container mt-4" id="companiesApp">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Firma Yonetimi</h2>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle me-1"></i> Yeni Firma
        </button>
    </div>

    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <div class="row g-3" data-bind="foreach: companies, visible: !isLoading()">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title" data-bind="text: name"></h5>
                    <!-- ko if: contactEmail -->
                    <p class="mb-1"><i class="bi bi-envelope me-1"></i><span data-bind="text: contactEmail"></span></p>
                    <!-- /ko -->
                    <!-- ko if: contactPhone -->
                    <p class="mb-1"><i class="bi bi-telephone me-1"></i><span data-bind="text: contactPhone"></span></p>
                    <!-- /ko -->
                    <!-- ko if: address -->
                    <p class="mb-0 text-muted small" data-bind="text: address"></p>
                    <!-- /ko -->
                </div>
                <div class="card-footer bg-transparent text-end">
                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteCompany">
                        <i class="bi bi-trash me-1"></i>Sil
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div data-bind="visible: !isLoading() && companies().length === 0" class="text-center py-5 text-muted">
        <i class="bi bi-building display-1"></i>
        <p class="mt-2">Henuz firma yok.</p>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Firma</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form data-bind="submit: saveCompany">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Firma Adi</label>
                        <input type="text" class="form-control" data-bind="value: formData().name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-posta</label>
                        <input type="email" class="form-control" data-bind="value: formData().contactEmail">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefon</label>
                        <input type="text" class="form-control" data-bind="value: formData().contactPhone">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adres</label>
                        <textarea class="form-control" rows="2" data-bind="value: formData().address"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="submit" class="btn btn-primary" data-bind="disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Companies.js"></script>
}
